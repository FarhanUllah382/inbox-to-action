# Which LLM phase1_extraction/extractor.py calls — "anthropic" (default) or
# "gemini". Leave unset for the default; only the chosen provider's key below
# needs to be filled in.
LLM_PROVIDER=anthropic

# Anthropic API Configuration
ANTHROPIC_API_KEY=your_api_key_here

# Gemini API Configuration (only used if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_api_key_here
# Defaults to gemini-2.5-flash if unset — override only once a newer model
# is confirmed stable (see phase1_extraction/config.py's comment).
GEMINI_MODEL=gemini-2.5-flash

# Single-owner API access token (app/auth.py). Required for every route
# except /health and GET /auth/google/callback. Must be at least 32
# characters — shorter or unset fails every request closed (401), it does
# NOT disable auth. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_ACCESS_TOKEN=

# Database (Postgres — run via `docker compose up -d`)
DATABASE_URL=postgresql://inbox:inbox@localhost:5432/inbox_to_action

# Google OAuth (needed once Gmail integration is wired up — leave unset until then)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Single MVP test user (Decision 5: no UTC fallback — timezone must be explicit)
USER_TIMEZONE=Asia/Karachi

# Notion
NOTION_API_KEY=
NOTION_DATABASE_ID=

# V2.7 — automatic Gmail poll interval, in seconds. Defaults to 120 (2 min).
# Safe to lower for a live demo (e.g. 15) so autonomous monitoring visibly
# fires without a long wait — the failure-backoff floor stays fixed at 10
# minutes regardless (app/scheduler.py), so this never weakens that
# fail-safe. Remember to unset or restore this before/after demoing.
GMAIL_POLL_INTERVAL_SECONDS=15
