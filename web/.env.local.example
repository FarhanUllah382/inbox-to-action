# URL of the FastAPI backend (app/main.py). The default matches `uvicorn
# app.main:app --reload`'s local port — only change this if the backend is
# running somewhere else.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Build-time only, set to "true" ONLY when building against a backend
# that's actually running with DEMO_MODE=true (see render.yaml's
# inbox-to-action-demo-web). Skips the GET /api/info call entirely and
# shows the demo UI immediately — leave unset for local dev against a
# normal (non-demo) backend.
NEXT_PUBLIC_DEMO_MODE=false
